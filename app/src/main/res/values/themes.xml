<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately minimal. The real design system lives in Compose
      (ui/theme/*.kt); this exists only so the window has sane colours
      before the first frame and during the splash.
    -->
    <style name="Theme.YourMoney" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
